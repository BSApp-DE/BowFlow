{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.bowflow.example/core/schemas/problem.schema.json",
  "title": "Fehlerantwort",
  "type": "object",
  "required": [
    "code",
    "message"
  ],
  "additionalProperties": false,
  "properties": {
    "code": {
      "enum": [
        "UNAUTHORIZED",
        "FORBIDDEN",
        "OUTSIDE_TIME_WINDOW",
        "NOT_FOUND",
        "VALIDATION_FAILED",
        "JOIN_CODE_INVALID",
        "RATE_LIMITED"
      ]
    },
    "message": {
      "type": "string"
    }
  }
}
