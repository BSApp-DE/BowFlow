{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.bowflow.example/profiles/league/schemas/event-state.schema.json",
  "title": "Freigabe-Stand (lesen und schreiben)",
  "type": "object",
  "required": ["state", "match_states"],
  "additionalProperties": false,
  "properties": {
    "state": { "$ref": "common.schema.json#/$defs/EventStateValue" },
    "match_states": {
      "type": "array",
      "description": "Ein Eintrag je Match des Spielplans.",
      "items": {
        "type": "object",
        "required": ["number", "state"],
        "additionalProperties": false,
        "properties": {
          "number": { "$ref": "common.schema.json#/$defs/MatchNumber" },
          "state": { "$ref": "common.schema.json#/$defs/MatchState" }
        }
      }
    }
  }
}
