{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.bowflow.example/profiles/league/schemas/lineup.schema.json",
  "title": "Meldung der Schützen (lesen und schreiben)",
  "type": "object",
  "required": ["scoresheet_id", "athletes"],
  "additionalProperties": false,
  "properties": {
    "scoresheet_id": { "$ref": "../../../core/schemas/common.schema.json#/$defs/Id" },
    "athletes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["position", "start_number", "first_name", "last_name"],
        "additionalProperties": false,
        "properties": {
          "position": { "type": "integer", "minimum": 1, "description": "Schussreihenfolge." },
          "start_number": { "$ref": "common.schema.json#/$defs/StartNumber" },
          "first_name": { "type": "string", "minLength": 1 },
          "last_name": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
