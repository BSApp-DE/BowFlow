{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.bowflow.example/profiles/league/schemas/official-set.schema.json",
  "title": "Offizieller Satz (lesen und schreiben)",
  "type": "object",
  "required": ["scoresheet_id", "set_number", "shooters", "penalty_points"],
  "additionalProperties": false,
  "properties": {
    "scoresheet_id": { "$ref": "../../../core/schemas/common.schema.json#/$defs/Id" },
    "set_number": { "$ref": "common.schema.json#/$defs/SetNumber" },
    "shooters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start_number", "arrows"],
        "additionalProperties": false,
        "properties": {
          "start_number": { "$ref": "common.schema.json#/$defs/StartNumber" },
          "arrows": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/ArrowValue" } }
        }
      }
    },
    "penalty_points": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Strafpunkte der Mannschaft in diesem Satz; die Liga zieht sie von der Ringsumme ab." }
  }
}
