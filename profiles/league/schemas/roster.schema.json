{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.bowflow.example/profiles/league/schemas/roster.schema.json",
  "title": "Schützenliste einer Mannschaft (nur lesen)",
  "description": "Alle Schützen, die für die Mannschaft gemeldet werden können. Grundlage für die Meldung in der Scoring App.",
  "type": "object",
  "required": [
    "team",
    "members"
  ],
  "additionalProperties": false,
  "properties": {
    "team": {
      "$ref": "common.schema.json#/$defs/Team"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "start_number",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "start_number": {
            "$ref": "common.schema.json#/$defs/StartNumber"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
